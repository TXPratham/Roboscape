<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fleet_bringup</name>
  <version>1.0.0</version>
  <description>Complete fleet bringup package launching full multi-AMR warehouse system with DDS and rosbridge</description>
  <maintainer email="bringup@warehouse.local">Warehouse Fleet Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>
  <exec_depend>fleet_msgs</exec_depend>
  <exec_depend>warehouse_sim</exec_depend>
  <exec_depend>fleet_comms</exec_depend>
  <exec_depend>fleet_safety</exec_depend>
  <exec_depend>fleet_tasks</exec_depend>
  <exec_depend>fleet_nav</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
