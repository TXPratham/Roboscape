<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="small_warehouse">
    <physics name="1ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="libignition-gazebo-physics-system.so" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="libignition-gazebo-user-commands-system.so" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Sun -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Warehouse Floor -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 40</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 40</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.2 0.22 0.25 1</ambient>
            <diffuse>0.3 0.33 0.38 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Warehouse Shelf 1 (Left Aisle) -->
    <model name="shelf_row_1">
      <static>true</static>
      <pose>-4.0 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>1.6 8.0 2.5</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>1.6 8.0 2.5</size></box></geometry>
          <material><diffuse>0.15 0.35 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Warehouse Shelf 2 (Right Aisle) -->
    <model name="shelf_row_2">
      <static>true</static>
      <pose>4.0 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>1.6 8.0 2.5</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>1.6 8.0 2.5</size></box></geometry>
          <material><diffuse>0.15 0.35 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Staging Dock A (North) -->
    <model name="dock_station_a">
      <static>true</static>
      <pose>0 6.5 0.4 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>6.0 1.5 0.8</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>6.0 1.5 0.8</size></box></geometry>
          <material><diffuse>0.6 0.4 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Packing Station B (South) -->
    <model name="dock_station_b">
      <static>true</static>
      <pose>0 -6.5 0.4 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>6.0 1.5 0.8</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>6.0 1.5 0.8</size></box></geometry>
          <material><diffuse>0.6 0.4 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
