<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fleet_comms</name>
  <version>1.0.0</version>
  <description>DDS peer-to-peer communication, state publishers, and network impairment node for multi-AMR fleet</description>
  <maintainer email="comms@warehouse.local">Comms Architect</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>fleet_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
